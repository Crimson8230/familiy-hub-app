{
  "name": "family-hub-mobile",
  "version": "0.2.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "npm run generate:schema && tsc --noEmit",
    "test": "jest",
    "generate:schema": "node tests/tools/generate-schema.mjs",
    "test:host": "node tests/tools/nativeTestOrchestration.test.mjs && node tests/tools/androidPreview.test.mjs",
    "test:preview:android": "node tests/tools/run-android-preview.mjs",
    "test:native": "node tests/tools/run-native-tests.mjs"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "dependencies": {
    "expo": "58.0.19",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  }
}
